# ==============================================================================
# FormPilot — The Registration Hub: Environment Variables Template
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/formpilot_db

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET=changeme_in_production_to_a_secure_32_byte_string_minimum
AUTH_SECRET=changeme_in_production_to_a_secure_32_byte_string_minimum
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# Initial System Admins (comma-separated list of emails auto-bootstrapped on first login)
INITIAL_ADMIN_EMAILS=admin@wonderla.com,owner@wonderla.com

# Token Encryption Secret (32-byte secret for AES-256-GCM token encryption at rest)
ENCRYPTION_SECRET=wonderla_formpilot_aes256_encryption_secret_key_32b!

# Google Workspace OAuth Integration Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Optional Static Environment Fallbacks for Google Services
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id
GOOGLE_SHEETS_DEFAULT_ID=your_default_spreadsheet_id

# Public Form API Submission Base URL & Allowed Client Origins
PUBLIC_API_BASE_URL=http://localhost:3000
ALLOWED_PUBLIC_ORIGINS=http://localhost:3000,https://wonderla.com

# File Upload Constraints (bytes, default 5MB)
UPLOAD_MAX_BYTES=5242880
